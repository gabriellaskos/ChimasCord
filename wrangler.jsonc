{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-de-pobre",
  "main": "src/index.ts",
  // Sempre deixe isso na data de hoje quando for rodar `wrangler deploy`
  "compatibility_date": "2026-08-08",

  // Serve o front-end (public/) direto pelo mesmo Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // O worker roda primeiro em /room/*, pra poder fazer o upgrade de WebSocket.
    // Todo o resto cai direto nos arquivos estaticos.
    "run_worker_first": ["/room/*"]
  },

  // A "sala" de voz/chat vira um Durable Object: um objeto com estado
  // proprio (quem esta conectado) que vive na borda da rede da Cloudflare.
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],

  "observability": { "enabled": true }
}
